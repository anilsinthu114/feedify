{
  "name": "backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"bun run src/server.ts\"",
    "start": "bun run src/server.ts",
    "studio": "bunx drizzle-kit studio --config=drizzle.config.ts",
    "generate": "bunx drizzle-kit generate --config=drizzle.config.ts",
    "push": "bunx drizzle-kit push --config=drizzle.config.ts",
    "migrate": "bunx drizzle-kit push --config=drizzle.config.ts && echo '✅ Database up-to-date'"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "latest",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.0",
    "drizzle-kit": "^0.31.6",
    "nodemailer": "^7.0.10",
    "nodemon": "^3.1.10"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.15.3",
    "resend": "^6.4.1",
    "sql.js": "^1.13.0",
    "sqlite3": "^5.1.7"
  }
}
